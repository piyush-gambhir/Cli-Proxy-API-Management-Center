{
  "name": "cli-proxy-webui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "verify": "bun run test && bun run lint && bun run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@noble/hashes": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "1.20.0",
    "i18next": "^26.3.6",
    "motion": "^12.42.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-i18next": "^17.0.21",
    "react-router-dom": "^7.18.4",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "sass": "^1.101.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "overrides": {
    "form-data": "4.0.6",
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.16.8",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "follow-redirects": "1.16.1",
    "immutable": "5.1.8",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
