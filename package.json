{
  "name": "cli-proxy-webui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript7/bin/tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "verify": "bun run test && bun run lint && bun run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@noble/hashes": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "1.21.1",
    "i18next": "^27.1.1",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "form-data": "4.0.6",
    "@babel/core": "7.29.13",
    "@humanfs/node": "0.16.8",
    "brace-expansion": "5.0.13",
    "browserslist": "4.29.5",
    "follow-redirects": "1.16.3",
    "immutable": "5.1.10",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
